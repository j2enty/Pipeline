# macOS
.DS_Store

# OMC 세션 메타데이터
.omc/

# Claude Code 로컬 상태 (scheduled_tasks.lock·worktrees 등 — 커밋 대상 아님)
# 단, 프로젝트 하네스 설정(settings.json)은 예외로 추적 — 작업환경을 코드로 고정.
# 주의: 디렉토리 통째(.claude/)로 ignore 하면 하위 파일을 !로 되살릴 수 없어 .claude/* 사용.
.claude/*
!.claude/settings.json
!.claude/hooks/

# 환경 / 비밀
.env
.env.*
!.env.example
*.pem
*.key
secrets/

# IDE
.vscode/
.idea/
*.swp

# 로그 / 임시
*.log
tmp/
.cache/

# 노드 (도구로 쓰일 경우)
node_modules/

# 파이썬 (도구로 쓰일 경우)
__pycache__/
*.pyc
.venv/
venv/
