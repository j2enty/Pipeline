# GitHub App 인증 — Author 봇 (필수)
AUTHOR_APP_ID=
AUTHOR_PEM=/path/to/author-bot.private-key.pem
AUTHOR_INSTALLATION_ID=

# GitHub App 인증 — Reviewer 봇 (옵션: AI 리뷰 사용 시만)
REVIEWER_APP_ID=
REVIEWER_PEM=/path/to/reviewer-bot.private-key.pem
REVIEWER_INSTALLATION_ID=

# 자동화 동작 설정
# Reviewer 봇 로그인 prefix (AI 리뷰 사용 시 필수, 예: my-review-bot)
REVIEWER_BOT_LOGIN=
# 제외 모듈 JSON 배열 (옵션, 예: ["Design","Docs"])
MODULES_IGNORE=[]

# Slack 알림 (옵션)
SLACK_WEBHOOK_URL=

# Probot 설정
WEBHOOK_SECRET=your-webhook-secret-here
PORT=3000
LOG_LEVEL=info
NODE_ENV=production
