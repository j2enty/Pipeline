# GitHub App 인증 — Author 봇 (필수)
AUTHOR_APP_ID=
AUTHOR_PEM=/path/to/author-bot.private-key.pem
AUTHOR_INSTALLATION_ID=

# GitHub App 인증 — Reviewer 봇 (옵션: AI 리뷰 사용 시만)
REVIEWER_APP_ID=
REVIEWER_PEM=/path/to/reviewer-bot.private-key.pem
REVIEWER_INSTALLATION_ID=

# 자동화 동작 설정
# 조직/사용자 이름 (필수, Project v2 폴링 대상)
OWNER=
# 폴러가 동시에 모니터링할 GitHub Project v2 번호 배열 (필수)
# 예: 마일스톤 보드 + 상시 CS 보드 → [3, 5]
PROJECT_NUMBERS=[]
# 영역 모듈 이름 JSON 배열 (필수, 폴러가 어떤 레포에 dispatch 할지 식별)
# 예: ["Backend","Admin","Frontend","iOS","Android"]
MODULES=[]
# Reviewer 봇 로그인 prefix (AI 리뷰 사용 시 필수, 예: my-review-bot)
REVIEWER_BOT_LOGIN=
# 제외 모듈 JSON 배열 (옵션, 예: ["Design","Docs"])
MODULES_IGNORE=[]
# 폴링 간격 (옵션, 기본 300000ms = 5분)
STATUS_POLLER_INTERVAL_MS=300000
# DRY_RUN — true 시 dispatch 실제 발사 안 함 (로그만, 통합 테스트용)
DRY_RUN=false

# Slack 알림 (옵션)
SLACK_WEBHOOK_URL=

# Probot 설정
WEBHOOK_SECRET=your-webhook-secret-here
PORT=3000
LOG_LEVEL=info
NODE_ENV=production
