#!/usr/bin/env bash
# 가짜 gh — 테스트용 스텁.
# 모든 인자를 한 줄로 $GH_LOG 에 append 하고 exit 0.
# 부작용(레포 변경) 없이 install.sh 가 어떤 gh 호출을 했는지 기록만 한다.
#
# 특수 분기:
#   - `gh auth status`        → 인증 OK 로 통과 (exit 0)
#   - `gh api user --jq .login` 또는 `gh api ... --jq .sha` 류
#       → 빈 문자열 출력. caller-yml 설치 시 sha 가 비면 "신규 파일"(POST 없이 PUT) 경로로 분기.
#
# 로그 포맷: 인자들을 공백으로 join 한 한 줄. 테스트는 grep/카운트로 단언.

if [ -n "${GH_LOG:-}" ]; then
  printf '%s\n' "$*" >> "$GH_LOG"
fi

# gh auth status — install.sh check_requirements 통과용
if [ "${1:-}" = "auth" ] && [ "${2:-}" = "status" ]; then
  exit 0
fi

# gh api ... — sha 조회 등은 빈 문자열 반환(신규 파일 경로)
# user --jq .login 도 빈 문자열로 충분 (로그 출력용)
if [ "${1:-}" = "api" ]; then
  exit 0
fi

# 그 외 (secret set / variable set / label create / api PUT) — 성공만
exit 0
