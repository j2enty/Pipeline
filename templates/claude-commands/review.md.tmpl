      "completedAt": null
    }
  },
  "aggregate": {
    "verdict": null,
    "parentCommentUrl": null,
    "criticFindings": [
      {"severity": "...", "area": "...", "title": "...", "description": "...", "affected_prs": []}
    ],
    "completedAt": null
  },
